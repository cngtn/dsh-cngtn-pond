{
  "name": "@cngtn/dsh-cngtn-pond",
  "version": "1.3.0",
  "description": "A paper-and-ink theme for the DeepSeek Harness Web GUI: warm paper surfaces, hairline strokes, a monospace type ramp, near-square corners, and a living ASCII koi pond drawn behind the whole shell.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "bin/install.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.png"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/boot.mjs && node test/smoke.mjs",
    "verify": "node tools/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "displayName": "cngtn Pond",
    "description": "Paper-and-ink theme with a living ASCII koi pond behind the shell."
  },
  "devDependencies": {
    "playwright-core": "^1.56.0"
  },
  "bin": {
    "dsh-cngtn-pond": "./bin/install.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "koi",
    "paper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cngtn/dsh-cngtn-pond.git"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  }
}
