{
  "name": "@local/dsh-daoho-pond",
  "version": "1.0.0",
  "private": true,
  "description": "The daoho.dev paper-and-ink theme for the DeepSeekRuntime Web GUI: warm paper surfaces, hairline strokes, a monospace type ramp, near-square corners, and a living ASCII koi pond drawn behind the whole shell.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.png"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/boot.mjs && node test/smoke.mjs",
    "verify": "node tools/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "devDependencies": {
    "playwright-core": "^1.56.0"
  }
}